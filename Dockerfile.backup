FROM python:3.11-alpine

WORKDIR /app

# SQLite and core tools
RUN apk add --no-cache sqlite tzdata

COPY scripts/backup.py /app/backup.py
RUN chmod +x /app/backup.py

# Default environment
ENV DB_PATH=/app/data/budget.db
ENV BACKUP_DIR=/backups
ENV RETENTION_DAYS=30
ENV BACKUP_INTERVAL_HOURS=24

ENTRYPOINT ["python", "-u", "/app/backup.py"]
